{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fyrush",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fyrush",
      "database_id": "cdcaca1a-46a9-45e0-8f78-25069964826d",
      "migrations_table": "_hub_migrations",
      "migrations_dir": "server/db/migrations/sqlite"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "0fc8cc6837d141e08aba68bcd5d8683a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "fyrush"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "$DurableObject", "class_name": "$DurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["$DurableObject"] }]
}
